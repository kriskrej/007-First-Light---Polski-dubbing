# Explicit publication allowlist; production data stays local.
*
!/.gitignore
!/.gitattributes
!/*.md
!/LICENSE
!/pyproject.toml
!/requirements.txt
!/*.ps1
!/dub007/
!/dub007/*.py
!/tests/
!/tests/*.py
!/tools/
!/tools/*.py
!/docs/
!/docs/*.md
!/docs/status.json
!/docs/sources.json
!/config/
!/config/chapters.json
!/config/*.example.json
!/licenses/
!/licenses/*.txt
!/licenses/*.md
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/pull_request_template.md
!/.github/dependabot.yml
.env
.env.*
!/.env.example
**/__pycache__/
**/*.pyc
**/.venv/
/Runtime/
/Retail/
/research/
/artifacts/
/backups/
/cache/
/dist/
/build/
/*.egg-info/
/config/campaign.json
/config/campaign-casting.json
/config/casting.json
/config/first-mission-casting.json
/config/surround.json
**/*.wav
**/*.wem
**/*.rpkg
**/*.zip
**/*.exe
**/*.dll
**/*.sqlite3
**/*.log
